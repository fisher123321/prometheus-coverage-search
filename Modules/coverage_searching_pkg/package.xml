<?xml version="1.0"?>
<package format="2">
  <name>prometheus_coverage_search</name>
  <version>0.0.1</version>
  <description>Coverage search module for Prometheus UAV platform, inspired by FALCON algorithm</description>
  <maintainer email="todo@todo.com">wjy</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>laser_geometry</depend>
  <depend>pcl_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>prometheus_msgs</depend>

  <build_depend>eigen</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-all</exec_depend>
</package>
