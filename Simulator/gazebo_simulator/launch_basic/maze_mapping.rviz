    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /无人机1
        - /点云 - scan_point_cloud1
        - /octomap1
        - /octomap1/Octomap点云1
        - /覆盖搜索1
        - /覆盖搜索1/覆盖搜索-路径与目标1
