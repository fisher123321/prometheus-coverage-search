<launch>
  <!-- Start only after both simulated aircraft are airborne and stable. -->
  <arg name="uav1_id" default="1"/>
  <arg name="uav2_id" default="2"/>
  <arg name="fly_height" default="1.5"/>
  <node pkg="prometheus_two_uav_coverage_search" type="two_uav_depth_cloud_downsample_node" name="depth_downsample_uav1" output="screen">
    <param name="input_topic" value="/uav$(arg uav1_id)/camera/depth/color/points"/><param name="output_topic" value="/uav$(arg uav1_id)/camera/depth/color/points_downsampled"/>
    <param name="octomap_output_topic" value="/uav$(arg uav1_id)/camera/depth/color/points_octomap"/>
    <param name="leaf_size" value="0.10"/><param name="min_range" value="0.3"/><param name="max_range" value="3.0"/><param name="max_rate" value="10.0"/>
    <!-- Endpoints beyond OctoMap's 3.0 m max range are inserted as free-only rays. -->
    <param name="add_fov_clear_points" value="true"/><param name="fov_h" value="1.5708"/><param name="fov_v" value="1.287"/><param name="clear_point_range" value="3.15"/>
    <param name="local_state_topic" value="/uav$(arg uav1_id)/prometheus/state"/><param name="peer_state_topic" value="/uav$(arg uav1_id)/two_uav/rx/state"/>
    <param name="peer_clear_radius" value="0.40"/><param name="peer_clear_half_height" value="0.30"/><param name="peer_state_timeout" value="0.60"/>
    <param name="camera_offset_x" value="0.095"/><param name="camera_offset_y" value="0.0"/><param name="camera_offset_z" value="0.0"/><param name="camera_pitch" value="0.35"/>
  </node>
  <node pkg="prometheus_two_uav_coverage_search" type="two_uav_depth_cloud_downsample_node" name="depth_downsample_uav2" output="screen">
    <param name="input_topic" value="/uav$(arg uav2_id)/camera/depth/color/points"/><param name="output_topic" value="/uav$(arg uav2_id)/camera/depth/color/points_downsampled"/>
    <param name="octomap_output_topic" value="/uav$(arg uav2_id)/camera/depth/color/points_octomap"/>
    <param name="leaf_size" value="0.10"/><param name="min_range" value="0.3"/><param name="max_range" value="3.0"/><param name="max_rate" value="10.0"/>
    <!-- Endpoints beyond OctoMap's 3.0 m max range are inserted as free-only rays. -->
    <param name="add_fov_clear_points" value="true"/><param name="fov_h" value="1.5708"/><param name="fov_v" value="1.287"/><param name="clear_point_range" value="3.15"/>
    <param name="local_state_topic" value="/uav$(arg uav2_id)/prometheus/state"/><param name="peer_state_topic" value="/uav$(arg uav2_id)/two_uav/rx/state"/>
    <param name="peer_clear_radius" value="0.40"/><param name="peer_clear_half_height" value="0.30"/><param name="peer_state_timeout" value="0.60"/>
    <param name="camera_offset_x" value="0.095"/><param name="camera_offset_y" value="0.0"/><param name="camera_offset_z" value="0.0"/><param name="camera_pitch" value="0.35"/>
  </node>
  <node pkg="octomap_server" type="octomap_server_node" name="octomap_server_uav1" output="screen">
    <remap from="/octomap_point_cloud_centers" to="/uav$(arg uav1_id)/octomap_point_cloud_centers"/><remap from="/octomap_full" to="/uav$(arg uav1_id)/octomap_full"/><remap from="/octomap_binary" to="/uav$(arg uav1_id)/octomap_binary"/><remap from="/projected_map" to="/uav$(arg uav1_id)/projected_map"/>
    <remap from="cloud_in" to="/uav$(arg uav1_id)/camera/depth/color/points_octomap"/>
    <param name="resolution" value="0.1"/><param name="frame_id" value="world"/><param name="base_frame_id" value="world"/><param name="sensor_model/max_range" value="3.0"/>
    <!-- D435i scans often contain no floor plane.  Do not run OctoMap's RANSAC
         ground detector; it only emits warnings and is not used for planning. -->
    <!-- Filter in world frame before insertion.  This is what keeps the floor
         out of octomap_binary/full, unlike occupancy_min_z which only filters
         marker and 2D-projection output. -->
    <param name="pointcloud_min_z" value="0.20"/><param name="pointcloud_max_z" value="2.8"/>
    <param name="occupancy_min_z" value="0.20"/><param name="filter_ground" value="false"/>
  </node>
  <node pkg="octomap_server" type="octomap_server_node" name="octomap_server_uav2" output="screen">
    <remap from="/octomap_point_cloud_centers" to="/uav$(arg uav2_id)/octomap_point_cloud_centers"/><remap from="/octomap_full" to="/uav$(arg uav2_id)/octomap_full"/><remap from="/octomap_binary" to="/uav$(arg uav2_id)/octomap_binary"/><remap from="/projected_map" to="/uav$(arg uav2_id)/projected_map"/>
    <remap from="cloud_in" to="/uav$(arg uav2_id)/camera/depth/color/points_octomap"/>
    <param name="resolution" value="0.1"/><param name="frame_id" value="world"/><param name="base_frame_id" value="world"/><param name="sensor_model/max_range" value="3.0"/>
    <param name="pointcloud_min_z" value="0.20"/><param name="pointcloud_max_z" value="2.8"/>
    <param name="occupancy_min_z" value="0.20"/><param name="filter_ground" value="false"/>
  </node>
  <include file="$(find prometheus_two_uav_coverage_search)/launch/two_uav_onboard.launch">
    <arg name="uav_id" value="$(arg uav1_id)"/><arg name="peer_uav_id" value="$(arg uav2_id)"/><arg name="fly_height" value="$(arg fly_height)"/>
    <arg name="global_coverage_source" value="$(arg uav1_id)"/>
    <arg name="tx_prefix" value="/uav$(arg uav1_id)/two_uav/tx"/><arg name="rx_prefix" value="/uav$(arg uav1_id)/two_uav/rx"/>
  </include>
  <include file="$(find prometheus_two_uav_coverage_search)/launch/two_uav_onboard.launch">
    <arg name="uav_id" value="$(arg uav2_id)"/><arg name="peer_uav_id" value="$(arg uav1_id)"/><arg name="fly_height" value="$(arg fly_height)"/>
    <arg name="global_coverage_source" value="$(arg uav1_id)"/>
    <arg name="tx_prefix" value="/uav$(arg uav2_id)/two_uav/tx"/><arg name="rx_prefix" value="/uav$(arg uav2_id)/two_uav/rx"/>
  </include>
  <node pkg="prometheus_two_uav_coverage_search" type="two_uav_fov_visualizer" name="fov_visualizer_uav1" output="screen">
    <param name="uav_id" value="$(arg uav1_id)"/>
  </node>
  <node pkg="prometheus_two_uav_coverage_search" type="two_uav_fov_visualizer" name="fov_visualizer_uav2" output="screen">
    <param name="uav_id" value="$(arg uav2_id)"/>
  </node>
  <include file="$(find prometheus_two_uav_coverage_search)/launch/two_uav_bridge.launch">
    <arg name="local_ip" value="127.0.0.1"/><arg name="peer_ip" value="127.0.0.1"/>
    <arg name="tx_prefix" value="/uav$(arg uav1_id)/two_uav/tx"/><arg name="rx_prefix" value="/uav$(arg uav1_id)/two_uav/rx"/><arg name="port_base" value="31000"/><arg name="peer_port_base" value="32000"/>
  </include>
  <include file="$(find prometheus_two_uav_coverage_search)/launch/two_uav_bridge.launch">
    <arg name="local_ip" value="127.0.0.1"/><arg name="peer_ip" value="127.0.0.1"/>
    <arg name="tx_prefix" value="/uav$(arg uav2_id)/two_uav/tx"/><arg name="rx_prefix" value="/uav$(arg uav2_id)/two_uav/rx"/><arg name="port_base" value="32000"/><arg name="peer_port_base" value="31000"/>
  </include>
</launch>
